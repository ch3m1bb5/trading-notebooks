# Copie para .env e preencha com SUAS chaves (todas opcionais)

# CoinMarketCap (crypto_trading_XRP...) — https://coinmarketcap.com/api
# Sem chave, o notebook usa a Binance como fallback
CMC_API_KEY=SUA_CHAVE_AQUI

# Alertas por e-mail (Caderno_Trading_*)
SMTP_SERVER=smtp.seuservidor.com
SMTP_PORT=587
SMTP_USER=seu_usuario
SMTP_PASSWORD=sua_senha_de_app
SMTP_FROM=alertas@seudominio.com
EMAIL_TO=voce@seudominio.com

# Alertas por webhook (Slack / Discord / Teams)
WEBHOOK_URL=https://seu-webhook-aqui
